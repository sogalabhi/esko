[Unit]
Description=BriefForge API (FastAPI)
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/esko/backend
# One worker: the project state lives in files under backend/data, so a second worker could race on it.
ExecStart=/home/ubuntu/.local/bin/uv run --frozen uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 1 --proxy-headers
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
